msgstr ""
"È installato un %s di un altro plugin, che è stato lasciato al suo posto."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:279
#, php-format
msgid ""
"The wp-content directory is not writable, so %s could not be installed. Make "
"the directory writable and try again, or copy the file there manually from "
"the plugin folder."
msgstr ""
"La directory wp-content non è scrivibile, quindi non è stato possibile "
"installare %s. Rendila scrivibile e riprova, oppure copia lì il file "
"manualmente dalla cartella del plugin."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:284
