#. Description of the plugin
#: millicache.php
msgid ""
"The most flexible Full Page Cache for scaling WordPress sites. Enterprise-"
"grade in-memory store with Redis, ValKey, Dragonfly, KeyDB, or any "
"alternative."
msgstr ""
"La Full Page Cache più flessibile per siti WordPress che scalano. "
"Archiviazione in-memory di livello enterprise con Redis, ValKey, Dragonfly, "
"KeyDB o qualsiasi altra alternativa."

#. Author of the plugin
#: millicache.php
msgid "MilliPress Team"
msgstr "MilliPress Team"

