msgstr "%s è già installato e configurato correttamente."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:269
#, php-format
msgid "A higher-version %s is in place and was preserved."
msgstr "È già presente una versione più recente di %s, che è stata mantenuta."

