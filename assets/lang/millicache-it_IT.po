msgstr "Elimina le voci della cache per flag, ID di articoli o URL."

#: src/Rules/Actions/WP/ClearCache.php:48
msgid "Targets"
msgstr "Target"

#: src/Rules/Actions/WP/ClearCache.php:49
msgid "Cache entries to clear — flag patterns, post IDs, or URLs."
msgstr ""
"Le voci della cache da svuotare: pattern di flag, ID di articoli o URL."

#: src/Rules/Actions/WP/ClearCache.php:53
#: src/Rules/Actions/WP/ClearSiteCache.php:49
msgid "Expire Only"
msgstr "Solo scadenza"

#: src/Rules/Actions/WP/ClearCache.php:54
#: src/Rules/Actions/WP/ClearSiteCache.php:50
msgid ""
"Mark entries as stale instead of deleting, allowing grace-period serving."
msgstr ""
"Contrassegna le voci come obsolete invece di eliminarle, consentendo di "
"servirle durante il periodo di tolleranza."

#: src/Rules/Actions/WP/ClearSiteCache.php:44
msgid "Clear Site Cache"
msgstr "Svuota la cache del sito"

#: src/Rules/Actions/WP/ClearSiteCache.php:45
msgid "Clear all cache entries for the current site."
msgstr "Elimina tutte le voci della cache del sito corrente."

#: src/Rules/Actions/WP/RemoveFlag.php:68
msgid "Remove Flag"
msgstr "Rimuovi Flag"

#: src/Rules/Actions/WP/RemoveFlag.php:69
msgid "Remove a previously attached flag from the response."
msgstr "Rimuove dalla risposta un flag associato in precedenza."

#: src/Rules/Actions/WP/RemoveFlag.php:74
msgid "The flag identifier to remove from the response."
msgstr "L'identificatore del flag da rimuovere dalla risposta."

#: assets/js/settings/partials/ClearCacheButton.jsx:60 build/settings.js:1
msgid ""
"Enter one or more flag patterns to clear across the network. Use a site-"
"prefixed pattern like \"5:*\" to clear every entry on a specific site, "
"\"*:posts\" to clear a flag on every site, or \"5:posts\" for a single flag "
"on a single site. Leave empty to clear the entire network cache."
msgstr ""
"Inserisci uno o più pattern di flag da svuotare in tutto il network. Usa un "
"pattern con prefisso del sito come “5:*” per svuotare tutte le voci di un "
"sito specifico, “*:posts” per svuotare un flag su tutti i siti, oppure "
"“5:posts” per un singolo flag su un singolo sito. Lascia vuoto per svuotare "
"l'intera cache del network."

#: assets/js/settings/partials/ClearCacheButton.jsx:64 build/settings.js:1
msgid ""
"Enter one or more Cache Flags, Post-IDs or URLs for which you want to clear "
"the cache. You can use wildcards (*) to clear multiple related flags."
msgstr ""
"Inserisci uno o più flag di cache, ID di articoli o URL di cui vuoi svuotare "
"la cache. Puoi usare i caratteri jolly (*) per svuotare più flag correlati."

#: assets/js/settings/partials/ClearCacheButton.jsx:73 build/settings.js:1
msgid "Targets to clear (Optional)"
msgstr "Target da svuotare (facoltativo)"

#: assets/js/settings/partials/ClearCacheButton.jsx:86 build/settings.js:1
msgid "Clear Network Cache"
msgstr "Svuota la cache del network"

#: assets/js/settings/partials/ClearCacheButton.jsx:88 build/settings.js:1
msgid "Clear Cache of Targets"
msgstr "Svuota la cache dei target"

