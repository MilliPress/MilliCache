#: src/Admin/Deactivator.php:96
msgid "MilliCache deactivated & advanced-cache.php removed."
msgstr "MilliCache désactivé et advanced-cache.php supprimé."

#: src/Admin/Deactivator.php:99
msgid ""
"Your version of advanced-cache.php is higher than the original plugin "
"version. We did not delete it, please do it yourself."
msgstr ""
"Votre version d’advanced-cache.php est plus récente que celle fournie par "
"l’extension. Elle n’a pas été supprimée, veuillez le faire vous-même."

#: src/Admin/Deactivator.php:104
msgid ""
"The wp-content directory is not writable. Please remove advanced-cache.php "
"manually."
msgstr ""
"Le répertoire wp-content n’est pas accessible en écriture. Veuillez "
"supprimer advanced-cache.php manuellement."

#: src/Admin/Deactivator.php:107
msgid "Could not remove advanced-cache.php. Please remove it manually."
msgstr ""
"Impossible de supprimer advanced-cache.php. Veuillez supprimer le fichier "
"manuellement."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:254
#, php-format
msgid "Created symlink for %s."
msgstr "Lien symbolique créé pour %s."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:259
#, php-format
msgid "Copied %s to the wp-content directory."
msgstr "%s copié dans le répertoire wp-content."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:264
#, php-format
msgid "%s is already installed and correctly configured."
msgstr "%s est déjà installé et correctement configuré."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:269
#, php-format
msgid "A higher-version %s is in place and was preserved."
msgstr "Une version plus récente de %s est déjà en place et a été conservée."

#. translators: %s: drop-in filename, e.g. object-cache.php.
#: src/Admin/DropIn.php:274
#, php-format
msgid "A third-party %s is installed and was left in place."
msgstr "Un %s d’un autre plugin est installé et a été laissé en place."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:279
#, php-format
msgid ""
"The wp-content directory is not writable, so %s could not be installed. Make "
"the directory writable and try again, or copy the file there manually from "
"the plugin folder."
msgstr ""
"Le répertoire wp-content n’est pas accessible en écriture, %s n’a donc pas "
"pu être installé. Rendez-le accessible en écriture et réessayez, ou copiez-y "
"le fichier manuellement depuis le dossier du plugin."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:284
#, php-format
msgid ""
"Could not install %s. Copy it manually from the plugin folder to the wp-"
"content directory."
msgstr ""
"Impossible d’installer %s. Copiez le fichier manuellement depuis le dossier "
"du plugin vers le répertoire wp-content."

