msgstr "Remplace la durée de vie du cache (TTL) pour la requête actuelle."

#: src/Rules/Actions/PHP/SetTtl.php:63
msgid "TTL"
msgstr "TTL"

#: src/Rules/Actions/PHP/SetTtl.php:64
msgid "How long to cache the response, in seconds."
msgstr "Durée de mise en cache de la réponse, en secondes."

#: src/Rules/Actions/WP/AddFlag.php:68
