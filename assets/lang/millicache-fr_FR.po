msgstr "Identifiant de la dimension du Bucket (par ex. device, tenant, ab)."

#: src/Rules/Actions/PHP/SetBucket.php:66
msgid "Token"
msgstr "Token"

#: src/Rules/Actions/PHP/SetBucket.php:67
