#: src/Rules/Actions/PHP/SetBucket.php:57
msgid "Set Bucket"
msgstr "Définir un Bucket"

#: src/Rules/Actions/PHP/SetBucket.php:58
msgid ""
"Add a bucket (name + token) to the request hash so matching requests share a "
"cache entry."
msgstr ""
"Ajoute un Bucket (nom + token) au hash de la requête afin que les requêtes "
"correspondantes partagent la même entrée de cache."

#: src/Rules/Actions/PHP/SetBucket.php:62
msgid "Bucket Name"
msgstr "Nom du Bucket"

#: src/Rules/Actions/PHP/SetBucket.php:63
