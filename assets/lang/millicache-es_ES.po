#: src/Admin/UI/CacheActions.php:88
#: src/Admin/UI/CacheActions.php:160
#: src/Admin/UI/CacheActions.php:170
msgid "The network cache has been cleared."
msgstr "Se ha vaciado la caché de la red."

#: src/Admin/UI/CacheActions.php:91
#: src/Admin/UI/CacheActions.php:113
msgid "The site cache has been cleared."
msgstr "Se ha vaciado la caché del sitio."

#: src/Admin/UI/CacheActions.php:98
msgid "No flags provided to clear cache."
msgstr "No se han indicado flags para vaciar la caché."

#: src/Admin/UI/CacheActions.php:103
msgid "The current page cache has been cleared."
msgstr "Se ha vaciado la caché de la página actual."

#: src/Admin/UI/CacheActions.php:109
#: src/Admin/UI/CacheActions.php:166
msgid "Invalid targets parameter. Must be a string or an array."
msgstr "Parámetro targets no válido: debe ser una cadena o un array."

#: src/Admin/UI/CacheActions.php:114
#: src/Admin/UI/CacheActions.php:173
msgid "Cache for the targets has been cleared."
msgstr "Se ha vaciado la caché de los destinos indicados."

#: src/Admin/UI/CacheActions.php:133
#: src/Admin/UI/CacheActions.php:201
msgid "Failed to perform cache action: "
msgstr "No se ha podido ejecutar la acción de caché: "

#: src/Admin/UI/Sections/Cache.php:52
msgid "TTL (Cache Expiry)"
msgstr "TTL (caducidad de la caché)"

#: src/Admin/UI/Sections/Cache.php:53
msgid "Time To Live - How long cache is considered fresh before becoming stale. Fresh cache is served directly without regeneration."
msgstr ""
"Time To Live: cuánto tiempo se considera fresca la caché antes de quedar "
"obsoleta (stale). La caché fresca se sirve directamente, sin regenerarla."

#: src/Admin/UI/Sections/Cache.php:60
msgid "Seconds"
msgstr "Segundos"

#: src/Admin/UI/Sections/Cache.php:64
msgid "Minutes"
msgstr "Minutos"

#: src/Admin/UI/Sections/Cache.php:68
#: src/Admin/UI/Sections/Cache.php:87
msgid "Hours"
msgstr "Horas"

#: src/Admin/UI/Sections/Cache.php:72
#: src/Admin/UI/Sections/Cache.php:91
msgid "Days"
msgstr "Días"

#: src/Admin/UI/Sections/Cache.php:79
#: src/Rules/Actions/PHP/SetGrace.php:63
msgid "Grace Period"
msgstr "Período de gracia"

#: src/Admin/UI/Sections/Cache.php:80
msgid "Time after TTL expiration when stale cache can still be served while new content is generated in the background. Helps reduce user wait times. 0 = disable."
msgstr ""
"Tiempo tras la caducidad del TTL durante el cual la caché obsoleta aún puede "
"servirse mientras el nuevo contenido se genera en segundo plano. Reduce los "
"tiempos de espera de los visitantes. 0 = desactivado."

#: src/Admin/UI/Sections/Cache.php:95
msgid "Weeks"
msgstr "Semanas"

#: src/Admin/UI/Sections/Cache.php:99
msgid "Months"
msgstr "Meses"

#: src/Admin/UI/Sections/Cache.php:106
msgid "Enable Gzip Compression"
msgstr "Activar la compresión Gzip"

#: src/Admin/UI/Sections/Cache.php:107
msgid "Compresses cached data to reduce storage space usage. Slightly increases CPU usage but significantly reduces memory consumption."
msgstr ""
"Comprime los datos en caché para reducir el espacio de almacenamiento. "
"Aumenta ligeramente el uso de CPU, pero reduce notablemente el consumo de "
"memoria."

#: src/Admin/UI/Sections/Cache.php:113
msgid "Enable Debugging"
msgstr "Activar la depuración"

#: src/Admin/UI/Sections/Cache.php:114
msgid "Adds detailed debug information to response headers such as the cache flags and times."
msgstr ""
"Añade información de depuración detallada a las cabeceras de respuesta, como "
"los flags de caché y las marcas de tiempo."

#: src/Admin/UI/Sections/Cache.php:120
msgid "No-Cache Paths"
msgstr "Rutas No-Cache"

#: src/Admin/UI/Sections/Cache.php:121
msgid "URL paths that are not cached. You can use * wildcards (e.g. \"/shop/*\") or regular expressions enclosed in / characters."
msgstr ""
"Rutas de URL que no se almacenan en caché. Puedes usar comodines * (p. ej. «/"
"shop/*») o expresiones regulares delimitadas por caracteres /."

#: src/Admin/UI/Sections/Cache.php:122
msgid "Add path or pattern (e.g. \"/shop/\", \"/blog/*\")"
msgstr "Añadir ruta o patrón (p. ej. «/shop/», «/blog/*»)"

#: src/Admin/UI/Sections/Cache.php:128
msgid "No-Cache Cookies"
msgstr "Cookies No-Cache"

#: src/Admin/UI/Sections/Cache.php:129
msgid "Cookies that prevent caching. Example: \"session_*\" will skip caching if a cookie starting with \"session_\" is set. * = wildcard."
msgstr ""
"Cookies que impiden el almacenamiento en caché. Ejemplo: «session_*» omite "
"la caché en cuanto hay una cookie que empiece por «session_». * = comodín."

#: src/Admin/UI/Sections/Cache.php:130
msgid "Add cookie name or pattern (e.g. \"session_*\")"
msgstr "Añadir nombre de cookie o patrón (p. ej. «session_*»)"

#: src/Admin/UI/Sections/Cache.php:136
msgid "Ignored Cookies"
msgstr "Cookies ignoradas"

#: src/Admin/UI/Sections/Cache.php:137
msgid "Cookies that are ignored when creating cache keys. Example: \"dark_mode\" means all users share the same cache regardless of the preference. * = wildcard."
msgstr ""
"Cookies que se ignoran al generar las claves de caché. Ejemplo: «dark_mode» "
"hace que todos los visitantes compartan la misma caché, independientemente "
"de esa preferencia. * = comodín."

#: src/Admin/UI/Sections/Cache.php:138
msgid "Add cookie name or pattern (e.g. \"dark_mode\")"
msgstr "Añadir nombre de cookie o patrón (p. ej. «dark_mode»)"

#: src/Admin/UI/Sections/Cache.php:144
msgid "Ignored Request Keys"
msgstr "Parámetros de URL ignorados"

#: src/Admin/UI/Sections/Cache.php:145
msgid "URL parameters that are ignored when creating cache keys. Example: \"utm_*\" means analytics parameters are ignored. * = wildcard."
msgstr ""
"Parámetros de URL que se ignoran al generar las claves de caché. Ejemplo: «"
"utm_*» ignora todos los parámetros de analítica. * = comodín."

#: src/Admin/UI/Sections/Cache.php:146
msgid "Add parameter name or pattern (e.g. \"utm_*\")"
msgstr "Añadir nombre de parámetro o patrón (p. ej. «utm_*»)"

#: src/Admin/UI/Sections/Storage.php:48
msgid "Server Host"
msgstr "Host del servidor"

#: src/Admin/UI/Sections/Storage.php:49
msgid "The hostname or IP address of your Redis, Valkey, KeyDB, or other compatible server. Typically \"localhost\" or \"127.0.0.1\" for local servers."
msgstr ""
"El nombre de host o la dirección IP de tu servidor Redis, Valkey, KeyDB u "
"otro compatible. Normalmente «localhost» o «127.0.0.1» para servidores "
"locales."

#: src/Admin/UI/Sections/Storage.php:57
msgid "Server Port"
msgstr "Puerto del servidor"

#: src/Admin/UI/Sections/Storage.php:58
msgid "The port your storage server listens on. Default is 6379 for most installations."
msgstr ""
"El puerto en el que escucha tu servidor de almacenamiento. El valor por "
"defecto es 6379 en la mayoría de las instalaciones."

#: src/Admin/UI/Sections/Storage.php:69
msgid "Username"
msgstr "Nombre de usuario"

#: src/Admin/UI/Sections/Storage.php:70
msgid "Username used to authenticate with your Redis, Valkey, or other compatible server. Leave empty if your server does not use ACL with named users."
msgstr ""
"Nombre de usuario para autenticarte en tu servidor Redis, Valkey u otro "
"compatible. Déjalo vacío si tu servidor no usa ACL con usuarios con nombre."

#: src/Admin/UI/Sections/Storage.php:77
