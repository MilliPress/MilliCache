#. Description of the plugin
#: millicache.php
msgid ""
"The most flexible Full Page Cache for scaling WordPress sites. Enterprise-"
"grade in-memory store with Redis, ValKey, Dragonfly, KeyDB, or any "
"alternative."
msgstr ""
"La caché de página completa más flexible para sitios WordPress que escalan. "
"Almacenamiento en memoria de nivel empresarial con Redis, ValKey, Dragonfly, "
"KeyDB o cualquier alternativa."

#. Author of the plugin
#: millicache.php
msgid "MilliPress Team"
msgstr "MilliPress Team"

