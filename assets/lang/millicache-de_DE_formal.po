#: src/Admin/Deactivator.php:96
msgid "MilliCache deactivated & advanced-cache.php removed."
msgstr "MilliCache deaktiviert & advanced-cache.php entfernt."

#: src/Admin/Deactivator.php:99
msgid ""
"Your version of advanced-cache.php is higher than the original plugin "
"version. We did not delete it, please do it yourself."
msgstr ""
"Ihre advanced-cache.php ist neuer als die vom Plugin mitgelieferte Version. "
"Sie wurde nicht gelöscht – bitte entfernen Sie sie selbst."

#: src/Admin/Deactivator.php:104
msgid ""
"The wp-content directory is not writable. Please remove advanced-cache.php "
"manually."
msgstr ""
"Das Verzeichnis wp-content ist nicht beschreibbar. Bitte entfernen Sie "
"advanced-cache.php manuell."

#: src/Admin/Deactivator.php:107
msgid "Could not remove advanced-cache.php. Please remove it manually."
msgstr ""
"advanced-cache.php konnte nicht entfernt werden. Bitte entfernen Sie die "
"Datei manuell."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:254
#, php-format
msgid "Created symlink for %s."
msgstr "Symlink für %s erstellt."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:259
#, php-format
msgid "Copied %s to the wp-content directory."
msgstr "%s in das Verzeichnis wp-content kopiert."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:264
#, php-format
msgid "%s is already installed and correctly configured."
msgstr "%s ist bereits installiert und korrekt konfiguriert."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:269
#, php-format
msgid "A higher-version %s is in place and was preserved."
msgstr ""
"Eine neuere Version von %s ist bereits vorhanden und wurde beibehalten."

#. translators: %s: drop-in filename, e.g. object-cache.php.
#: src/Admin/DropIn.php:274
#, php-format
msgid "A third-party %s is installed and was left in place."
msgstr ""
"Ein %s eines anderen Plugins ist installiert und wurde unverändert belassen."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:279
#, php-format
msgid ""
"The wp-content directory is not writable, so %s could not be installed. Make "
"the directory writable and try again, or copy the file there manually from "
"the plugin folder."
msgstr ""
"Das Verzeichnis wp-content ist nicht beschreibbar, daher konnte %s nicht "
"installiert werden. Machen Sie das Verzeichnis beschreibbar und versuchen "
"Sie es erneut, oder kopieren Sie die Datei manuell aus dem Plugin-Ordner "
"dorthin."

#. translators: %s: drop-in filename, e.g. advanced-cache.php.
#: src/Admin/DropIn.php:284
#, php-format
msgid ""
"Could not install %s. Copy it manually from the plugin folder to the wp-"
"content directory."
msgstr ""
"%s konnte nicht installiert werden. Kopieren Sie die Datei manuell aus dem "
"Plugin-Ordner in das Verzeichnis wp-content."

