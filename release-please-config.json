{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-header": " ",
  "pull-request-footer": " ",
  "include-component-in-tag": false,
  "last-release-sha": "8544db532b25a5b42a31daac09d6e340fdb9e299",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": false,
      "versioning": "default",
      "component": "millicache",
      "changelog-path": "docs/01-getting-started/30-changelog.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "millicache.php",
          "regex": "\\* Version:\\s+(?<version>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "type": "generic",
          "path": "millicache.php",
          "regex": "define\\( 'MILLICACHE_VERSION', '(?<version>\\d+\\.\\d+\\.\\d+)' \\)"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Style",
          "hidden": true
        }
      ]
    }
  }
}
