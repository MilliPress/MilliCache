{
    "name": "millipress/millicache",
    "description": "WordPress Full-Page Cache based on Rules & Flags. Delivers flexible, scalable caching workflows backed by Redis and ValKey in-memory stores.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Philipp Wellmer",
            "email": "hello@millipress.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "millipress/millibase": "^2.6.0",
        "millipress/millirules": "^1.1.6",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "*",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "swissspidy/phpstan-no-private": "^1.0",
        "roave/security-advisories": "dev-latest",
        "pestphp/pest": "^4.0",
        "mockery/mockery": "^1.6",
        "brainmaestro/composer-git-hooks": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MilliCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MilliCache\\Tests\\": "tests/Unit/"
        }
    },
    "suggest": {
        "ext-zlib": "Allows MilliCache to compress the cache with zlib."
    },
    "scripts": {
        "test": [
            "@test:fix",
            "@test:lint",
            "@test:phpstan",
            "@test:unit"
        ],
        "test:unit": "pest --colors=always",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "test:phpstan": "phpstan analyse -c phpstan.neon --memory-limit 1G",
        "test:lint": "phpcs --standard=phpcs.xml -s",
        "test:fix": "phpcbf --standard=phpcs.xml",
        "cghooks": [
            "vendor/bin/cghooks"
        ],
        "post-install-cmd": "vendor/bin/cghooks add --ignore-lock",
        "post-update-cmd": "vendor/bin/cghooks update"
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "deps",
            "namespace_prefix": "MilliCache\\Deps\\",
            "classmap_prefix": "MilliCache_",
            "classmap_output": false,
            "update_call_sites": true,
            "delete_vendor_packages": true,
            "packages": [
                "predis/predis",
                "psr/http-message",
                "millipress/millirules",
                "millipress/millibase"
            ]
        },
        "hooks": {
            "config": {
                "stop-on-failure": ["pre-push"]
            },
            "pre-commit": [
                "composer test:fix",
                "npm run fix"
            ],
            "pre-push": [
                "composer validate --no-check-all --no-check-publish",
                "composer test",
                "npm run lint"
            ],
            "post-merge": [
                "composer install"
            ]
        }
    }
}
